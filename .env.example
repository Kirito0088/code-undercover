# PostgreSQL via Supabase (or any Postgres provider)
# For local dev, you can use a local Postgres instance:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/code_undercover"
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# Set to your production domain in prod (e.g. https://code-undercover.onrender.com)
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Nodemailer / Gmail (for password reset emails)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Piston Isolated Sandbox Code Execution API URL (Optional, defaults to public EMKC endpoint)
PISTON_API_URL="https://emkc.org/api/v2/piston/execute"