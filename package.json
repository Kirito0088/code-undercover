{
  "name": "code-undercover",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "npx prisma@^5.22.0 db seed",
    "db:generate": "npx prisma@^5.22.0 generate",
    "postinstall": "node -e \"if (!process.env.CI && !process.env.VERCEL_ENV && !process.env.DATABASE_URL?.startsWith('postgres')) process.exit(0);\" || npx prisma@^5.22.0 generate",
    "setup": "npx prisma@^5.22.0 generate && npx prisma@^5.22.0 db push && npm run seed",
    "doctor": "npx react-doctor@latest",
    "check:rls": "node scripts/check-rls.js",
    "prebuild": "node -e \"if (!process.env.VERCEL_ENV) process.exit(0)\" || npm run check:rls"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@types/bcryptjs": "^2.4.6",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.575.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.13",
    "postgres": "^3.4.9",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "jsdom": "^26.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
