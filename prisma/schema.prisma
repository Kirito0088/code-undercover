generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String        @id @default(uuid())
  name          String?
  username      String?       @unique
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  auraPoints    Int           @default(0)
  auraLevel     Int           @default(1)
  missionsCompleted Int       @default(0)
  foxBadges     Int           @default(0)
  preferredLanguage String    @default("C")
  passwordResetToken String?
  passwordResetExpires DateTime?
  comboStreak   Int           @default(0)
  maxCombo      Int           @default(0)
  hasSeenIntro  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  userMissions  UserMission[]
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Mission {
  id              String        @id @default(uuid())
  order           Int           @unique
  title           String
  description     String
  briefing        String        @default("")
  difficulty      String        @default("EASY")
  language        String        @default("C")
  type            String        @default("standard")
  goal            String?
  startingCode    String?
  auraReward      Int           @default(100)
  teachingContent String?       // JSON string of slides
  mcqContent      String?       // JSON string of MCQs
  validationRules String?       // JSON: { requiredKeywords, forbiddenPatterns, minLength, requiredOutput }
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userMissions    UserMission[]
}

model UserMission {
  id                 String    @id @default(uuid())
  userId             String
  missionId          String
  status             String    @default("LOCKED")
  phase              String    @default("TEACHING") // TEACHING, MCQ, CODING
  hintsUsed          Int       @default(0)
  attemptCount       Int       @default(0)
  innovationUnlocked Boolean   @default(false)
  submittedCode      String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
}

model DailyQuestion {
  id            String   @id @default(uuid())
  question      String
  options       String   // JSON array of strings
  correctAnswer String   // The correct option
  explanation   String   // Explains why it's correct
  createdAt     DateTime @default(now())
}

// Global, cross-student cache for AI-generated compiler error diagnostics.
// Keyed by computeErrorHash() (lib/errorHash.ts) over the normalized error
// message + broken line, so semantically identical beginner mistakes reuse
// one explanation instead of re-generating per student. See ADR-002.
model CompilerErrorCache {
  id          String   @id @default(uuid())
  errorHash   String   @unique
  explanation String   @db.Text
  directFix   String   @db.Text
  errorType   String?  // CompilerErrorType from lib/errorClassifier.ts, for analytics
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([errorHash])
}
