# judge0.conf is sourced with `env_file:` by docker-compose.yml and read
# inside a Linux container. A CRLF-ending value (from a Windows checkout
# with core.autocrlf=true, which has no .gitattributes override by
# default) leaves a trailing \r on every var, e.g. REDIS_HOST="judge0-redis\r"
# — that breaks the container's socket/hostname lookups outright. Force LF
# on checkout regardless of the checking-out machine's autocrlf setting.
judge0.conf text eol=lf

# T7 dataset + tooling: train.jsonl/val.jsonl are read by a Linux-side
# training pipeline (T8, likely on Oracle Cloud per T10/T11) — force LF so a
# Windows checkout with core.autocrlf=true doesn't inject \r into every row.
# generate_dataset.py/verify_dataset.py travel with the data they produce
# and consume, so pin them the same way for consistency.
scripts/ml/data/*.jsonl text eol=lf
scripts/ml/*.py text eol=lf

# T8 tooling read on the same Linux side: requirements.txt is fed to pip on
# the Oracle box, and the Modelfile emitted next to the merged checkpoint is
# parsed by Ollama. Same reasoning as the .py files above.
scripts/ml/requirements.txt text eol=lf
scripts/ml/outputs/**/Modelfile text eol=lf
